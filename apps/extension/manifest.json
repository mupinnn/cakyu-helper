{
  "manifest_version": 3,
  "name": "Cakyu Helper",
  "version": "1.2.0",
  "description": "Prefill lecture feedback Google Forms from RISE session cards.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rise.cakrawala.ac.id/*",
    "https://docs.google.com/forms/*",
    "https://cakyu-helper.13121957.xyz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Cakyu Helper",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://rise.cakrawala.ac.id/*"
      ],
      "js": [
        "tasks-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rise.cakrawala.ac.id/*"
      ],
      "js": [
        "rise.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "forms.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cakyu-helper@13121957.xyz",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/mupinnn/cakyu-helper/releases/latest/download/firefox-updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
